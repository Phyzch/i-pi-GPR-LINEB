<simulation mode="static" verbosity="medium">
    <output prefix='min'>
        <properties stride='1' filename='out'>  [ step, potential{electronvolt}] </properties>
        <trajectory stride="1" filename="xc" format="xyz">x_centroid{angstrom}</trajectory>
   </output>
   <total_steps>400       </total_steps>
   <ffsocket name="nwchem" mode="inet" pbc="false" >
       <address> localhost </address>
       <latency> 1.0000e-02</latency>
       <slots> 4 </slots>
       <port> 31415 </port>
       <timeout> 6.000e+02 </timeout>
   </ffsocket>
   <system >
       <initialize nbeads='1'> 
           <file mode='xyz' >  init.xyz </file>
           <cell mode='abc'> [200.0,  200.0,  200.0  ] </cell>
       </initialize>
       <forces>
          <force forcefield="nwchem"> </force>
       </forces>
      <motion mode="vibrations">
        <vibrations mode="fd">  <!-- use finite differences method -->
            <pos_shift> 0.01  </pos_shift>  <!-- Displacment length -->
            <prefix> phonons </prefix>
            <asr> none </asr>               <!-- Apply acoustic sume rule: none, crystal (translation) or poly(rotation and translation) -->
         </vibrations>
      </motion>
   </system>
</simulation>
