<simulation mode="static" verbosity="medium" threading="false">
    <output prefix='inst'>
        <properties stride='1' filename='out'>  [ step, potential{electronvolt}] </properties>
   </output>

   <total_steps> 101       </total_steps>

   <ffsocket name="nwchem" mode="inet" pbc="false" >
       <address> localhost </address>  
       <latency> 1.0000e-02</latency>
       <slots> 4 </slots>
       <port> 31415 </port>
       <timeout> 6.000e+02 </timeout>
   </ffsocket>

   <system>
       <initialize nbeads='10'>  <!-- nbeads: number of beads for representing Line Integral Nudged Elastic Band -->
           <file mode='xyz' >  init.xyz </file>
       </initialize>
       
       <forces>
          <force forcefield="nwchem"> </force>
       </forces>

       <ensemble>
          <temperature units='kelvin'> 275 </temperature>
       </ensemble>

       <normal_modes>
       <open_paths>  [0, 1, 2, 3, 4, 5, 6, 7, 8]    </open_paths>
       </normal_modes>

       <motion mode='nebinstantongpr'>
	    <nebinstantongpr mode='FIRE'>
	    <!-- stage of the algorithm. There are three stages: neb, instanton or converged -->
	    <!-- For instanton rate calculation, put in instanton -->
            <stage> instanton </stage>

	    <!-- number of ring polymer instanton beads for the interpolated instanton path. -->
            <instanton_bead_number>  20 </instanton_bead_number>


	   <!-- convergence criterion for LI-String / LI-NEB method -->
	   <tolerances>  
	   <gradient>  5e-3  </gradient> 
           <gradient_end_bead> 5e-3 </gradient_end_bead>
	   <action_forces_sum> 5e-3 </action_forces_sum>
	    </tolerances>

	   <!-- Parameter for FIRE algorithm for optimization --> 
	    <FIRE> 
		<tmax> 3.0 </tmax>
		<tmin> 0.1 </tmin>
		<Ndelay> 5 </Ndelay>
		<finc> 1.1 </finc>
   		<fdec> 0.5 </fdec> 
		<alpha0> 0.15 </alpha0>
  		<alpha_shrink> 0.99 </alpha_shrink>
		<Nmax> 100 </Nmax>
		<maxstep> 100 </maxstep>
		<neb_step_update_kappa> 20 </neb_step_update_kappa>
	    </FIRE>
		
	    <dynamical_adjust_ratio>
		<spring_k> 0.1 </spring_k>
                <kappa> 0.2  </kappa>
	    </dynamical_adjust_ratio>

	    <!-- optimization method. string or neb --> 
	    <opt> string </opt>

	    <!-- reactant state energy -->
            <energy_shift>  -267.148010 </energy_shift>  <!-- we can use units='electronvolt' etc to specify the unit of energy shift. If not specified, Hatree unit is assumed  -->
            
            <!-- time step for neb path optimization -->
	    <time_step units='femtosecond'>  0.05   </time_step>  <!-- time step for neb move -->
                <instanton_time_step units='femtosecond'> 0.05  </instanton_time_step>  <!-- time step for move along Minimum action path to generate instanton -->

		<!-- time step for move along Minimum action path to generate instanton -->
		<instanton_path_energy units='electronvolt'> 0.137 </instanton_path_energy>  <!-- energy of end beads relative to energy shift. This defines the temperature of our Minimum Action Path. -->
		
		<end_bead_energy_converge_value units='electronvolt'> 
		0.002 
		</end_bead_energy_converge_value>

		<!-- Parameters below are for GPR surrogate modeling -->
		<gpr_relative_force_error_criterion>  0.05 </gpr_relative_force_error_criterion>   <!-- criterion to stop the outer loop when relative gpr force error is below gpr_force_criterion -->
		<gpr_absolute_force_error_criterion> 0.002 </gpr_absolute_force_error_criterion> <!-- criterion to stop outer loop when absolute gpr force error is below gpr_absolute_force_criterion -->
		
		<gpr_trust_region> 0.2 </gpr_trust_region>  <!-- trust region to stop the inner loop -->

		<gpr_SE_kernel_number> 1 </gpr_SE_kernel_number>  <!-- number of Squared Exponential kernels to add together to form kernel of GPR -->

		<gpr_kernel_lengthscale_ratio_constraint>
			<min> 0.0 </min>
			<max>   10.0   </max>
		</gpr_kernel_lengthscale_ratio_constraint>

		<gpr_kernel_lengthscale_ratio>  
                [1.0] 
		</gpr_kernel_lengthscale_ratio>   <!-- mean value of prior of length scale. array. length should match Squared Exponential kernel number -->

		<gpr_kernel_outputscale_constraint>
			<min> 0.0 </min>
			<max> 10.0 </max>
		</gpr_kernel_outputscale_constraint>

		<gpr_kernel_outputscale>
			[0.1]
		</gpr_kernel_outputscale>   <!-- mean value of prior of output scale of kernel. length should match Squared Exponential kernel number -->

		<gpr_noise_std>  <!-- the size of noise term for potential and force should be different --> 
                <pot_noise_prior>   1e-6  </pot_noise_prior>     <!-- pot noise in cartesian coordinate. Hatree unit -->
                <force_noise_prior> 5e-5  </force_noise_prior>   <!-- noise in cartesian coordinate. Hatree / a.u. -->
		<hessian_noise_prior> 5e-3 </hessian_noise_prior>
		</gpr_noise_std>  		
		
		<!-- Bool decides: compute / interpolate hessian for ring polymer beads -->
		<final_hessian_bool>  True   </final_hessian_bool>		
		<!-- Bool decides: compute hessian for all beads with ab-initio method -->
		<ab_initio_hessian_bool> False </ab_initio_hessian_bool>

		<!-- Whether to use GPR or CubicSpline to interpolate Hessian. -->
                <Hessian_interpolation> GPR </Hessian_interpolation>

		<!-- add hessian data along the found instanton path for GPR / CubicSpline modeling -->
		<add_new_hessian_data_bool> True </add_new_hessian_data_bool>
		<candidate_hessian_data_number> 40 </candidate_hessian_data_number>
		<new_hessian_data_index> [ 0,  4,  8, 12, 16, 20, 24, 28, 32, 36] </new_hessian_data_index>
		
		<!-- add gradient data along the found instanton path for GPR modeling -->
		<add_new_grad_data_bool> False </add_new_grad_data_bool>
		<candidate_grad_data_number> 100 </candidate_grad_data_number>
		<!--
		<new_grad_data_index>  </new_grad_data_index>
		-->		
		
		<!-- folder path to load the GPR dataset for hessian modeling -->
		<!--
		<read_gpr_hessian_folder>  grad# 20 hessian# 10 </read_gpr_hessian_folder>	
 		-->	

		<train_hessian_model_bool> True </train_hessian_model_bool>
		
		<!-- Adaptive regression of Hessian -->
		<!-- for GPR model with only potential and gradient -->
		<gpr_fix_internal_dofs_cutoff> 1e-3 </gpr_fix_internal_dofs_cutoff>

		<!-- for GPR model with potential, gradient and Hessian -->
	   	<fix_dofs> [2, 5, 8, 10, 11, 13, 17, 20, 23, 26] </fix_dofs>
		<gpr_rigid_internal_dofs_cutoff> 2e-2 </gpr_rigid_internal_dofs_cutoff>

		<!-- If cross validation of GPR model is required -->
		<cross_validation_bool> False </cross_validation_bool>
            </nebinstantongpr>
       </motion>

   </system>
</simulation>
